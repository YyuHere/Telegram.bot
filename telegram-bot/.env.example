# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy this file to .env and fill in real values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Telegram API credentials
# Obtain from https://my.telegram.org/apps
API_ID=123456
API_HASH=your_api_hash_here

# Main bot token from @BotFather
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Pyrogram string session for the Assistant user account.
# Generate it once by running:  python generate_session.py
ASSISTANT_SESSION_STRING=BQA...your_session_string_here
